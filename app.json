{
  "expo": {
    "name": "Compras",
    "slug": "compras-negocio",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "compras",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.victorkiuw.compras"
    },
    "android": {
      "package": "com.victorkiuw.compras",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "La app usa la cámara para fotografiar tickets y facturas de compra.",
          "photosPermission": "La app accede a tus fotos para adjuntar tickets y facturas de compra."
        }
      ],
      "expo-font"
    ]
  }
}
